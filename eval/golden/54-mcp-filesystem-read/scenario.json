{
  "schema": 1,
  "kind": "app",
  "env": {
    "EVAL_KEY": "eval-provider-secret"
  },
  "config": {
    "agent": {
      "model": "mock/mock-1",
      "maxSteps": 8,
      "tools": [
        "mcp__fs__read_file",
        "write_file"
      ]
    },
    "mcpServers": {
      "fs": {
        "transport": "http",
        "url": "{{mcpUrl}}",
        "timeoutMs": 3000
      }
    }
  },
  "mcp": {
    "tools": [
      {
        "name": "read_file",
        "description": "Le um arquivo",
        "text": "MCP-FS-CONTENT"
      }
    ]
  },
  "turns": [
    {
      "toolCalls": [
        {
          "name": "mcp__fs__read_file",
          "arguments": {
            "path": "notes.txt"
          }
        },
        {
          "name": "write_file",
          "arguments": {
            "path": "out/mcp.txt",
            "content": "MCP-FS-OUTPUT\n"
          }
        }
      ]
    },
    {
      "content": "mcp ok"
    }
  ],
  "expect": {
    "final": "mcp ok",
    "audit": [
      "mcp.call",
      "tool.call",
      "run.completed"
    ],
    "auditText": [
      "\"status\":\"ok\""
    ],
    "requests": 2,
    "toolResultsContain": [
      "MCP-FS-CONTENT"
    ]
  }
}
